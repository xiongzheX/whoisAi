# 环境变量配置示例
# 可按需复制为 .env 或直接在启动命令前注入环境变量
# 未配置 AI_* 时，服务会自动退回本地规则改写

# Go 服务监听端口
PORT=3014

# OpenAI 兼容接口配置（可选）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# 可选，请求超时毫秒数
AI_TIMEOUT_MS=8000

# 可选：Neon / PostgreSQL。留空使用内存试玩；配置后连接失败会停止启动。
# 仅在本机 .env 或 Render Environment 中填写真实值，禁止提交连接凭证。
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
